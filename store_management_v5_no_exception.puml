@startuml 7_Application_Result
title 7. Application (Console UI)
top to bottom direction
skinparam shadowing false
skinparam classAttributeIconSize 0
skinparam nodesep 35
skinparam ranksep 50
skinparam class {
  BackgroundColor #EBF5FB
  BorderColor #2874A6
  BackgroundColor<<ref>> #EEEEEE
  BorderColor<<ref>> #999999
  BackgroundColor<<res>> #FDEDEC
  BorderColor<<res>> #CB4335
}
hide empty members

package "Application" {
  class Main {
    +main(args: String[]): void
  }
  class ConsoleApp {
    +run(): void
    -showMainMenu(): void
  }
  class ConsoleInput <<utility>> {
    +readRequiredText(msg: String): String
    +readPositiveInt(msg: String): int
    +readPositiveDouble(msg: String): double
  }
  class Validator <<utility>> {
    +isValidPhone(phone: String): boolean
    +isValidEmail(email: String): boolean
  }
}

package "Services" {
  class CustomerService <<ref>>
  class EmployeeService <<ref>>
  class SupplierService <<ref>>
  class MenuService <<ref>>
  class OrderService <<ref>>
  class ImportService <<ref>>
  class InventoryService <<ref>>
  class AuthService <<ref>>
  class ReportService <<ref>>
}

package "Common" {
  class Result<T> <<res>> {
    -success: boolean
    -message: String
    -data: T
    +{static} ok(data: T): Result<T>
    +{static} fail(message: String): Result<T>
    +isSuccess(): boolean
    +getMessage(): String
    +getData(): T
  }
}

Main ..> ConsoleApp : tao Repository, Service\nroi truyen vao ConsoleApp
ConsoleApp ..> ConsoleInput
ConsoleApp ..> Validator

ConsoleApp --> CustomerService
ConsoleApp --> EmployeeService
ConsoleApp --> SupplierService
ConsoleApp --> MenuService
ConsoleApp --> OrderService
ConsoleApp --> ImportService
ConsoleApp --> InventoryService
ConsoleApp --> AuthService
ConsoleApp --> ReportService

ConsoleApp ..> Result : doc ket qua

note bottom of ConsoleApp
  Chi ConsoleApp in ra console.
  Neu result.isSuccess() = false -> in result.getMessage().
  Cac tang duoi chi tra Result, khong tu System.out.println.
end note
@enduml
